<%- include('partials/cabecalho.ejs') %>

<style>
    .erro { padding: 120px 0 40px; max-width: 640px; }

    .erro .numero-urna { font-size: clamp(3rem, 9vw, 5rem); gap: 10px; }

    .erro .numero-urna span {
        color: var(--corrige);
        box-shadow: 0 0 0 1.5px rgba(196, 86, 26, .45), inset 0 -3px 0 rgba(196, 86, 26, .08), 0 18px 30px -18px rgba(196, 86, 26, .5);
    }

    .erro .numero-urna span:nth-child(2) { transform: rotate(-4deg) translateY(4px); }

    .erro .titulo { margin: 48px 0 0; font-size: clamp(2.25rem, 5.5vw, 3.75rem); }

    .erro .acoes { margin-top: 36px; }

    @media (max-width: 767px) { .erro { padding-top: 72px; } }
</style>

<main>
    <div class="container">
        <section class="erro" data-revelar>
            <%- include('partials/numero.ejs', { numero: 404 }) %>

            <h1 class="titulo"><%= titulo %></h1>
            <p class="subtitulo">O endereço não corresponde a nenhuma página. Confira o número digitado ou volte para a lista de candidatos.</p>

            <div class="acoes">
                <a href="/candidatos" class="botao botao-confirma">
                    Ver candidatos
                    <span class="botao-icone"><%- include('partials/seta.ejs') %></span>
                </a>
            </div>
        </section>
    </div>
</main>

<%- include('partials/rodape.ejs') %>
