<%- include('partials/cabecalho.ejs') %>

<style>
    .painel-grade {
        display: grid;
        grid-template-columns: 5fr 7fr;
        gap: 20px;
        align-items: start;
    }

    .bloco { padding: 32px; }

    .bloco .secao-titulo { margin-bottom: 6px; }

    .bloco-descricao { margin: 0 0 28px; color: var(--suave); font-size: .9375rem; }

    .campo { margin-bottom: 22px; }

    .campo label { display: block; margin-bottom: 8px; font-weight: 600; font-size: .9375rem; }

    .campo small { display: block; margin-top: 8px; color: var(--suave); font-size: .8125rem; }

    .campo input {
        width: 100%;
        min-height: 52px;
        padding: 0 18px;
        border: 0;
        border-radius: 16px;
        background: var(--fundo);
        box-shadow: inset 0 0 0 1px var(--anel), inset 0 2px 4px rgba(21, 25, 29, .04);
        font: 500 1rem var(--texto);
        color: var(--tinta);
        transition: box-shadow .4s var(--mola), background .4s var(--mola);
    }

    .campo input:hover { box-shadow: inset 0 0 0 1px var(--anel-forte); }

    .campo input:focus-visible {
        outline: none;
        background: #fff;
        box-shadow: inset 0 0 0 1.5px var(--confirma), 0 0 0 5px rgba(31, 138, 76, .12);
    }

    .campo input:user-invalid { box-shadow: inset 0 0 0 1.5px var(--corrige); }

    #numero {
        max-width: 200px;
        font: 700 1.375rem var(--display);
        letter-spacing: .18em;
        font-variant-numeric: tabular-nums;
    }

    .bloco .botao { width: 100%; justify-content: space-between; margin-top: 8px; }

    .relatorio-cabeca { padding: 32px 32px 12px; }

    table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }

    th, td { padding: 16px 32px; text-align: left; }

    thead th { color: var(--suave); font-weight: 500; font-size: .875rem; }

    tbody td { box-shadow: inset 0 1px 0 var(--anel); font-weight: 500; }

    td.num, th.num { text-align: right; }

    td.num { font: 700 1.125rem var(--display); }

    tbody td { vertical-align: middle; }

    .relatorio-candidato { display: flex; align-items: center; gap: 14px; }

    .relatorio-candidato img {
        width: 44px;
        height: 44px;
        flex-shrink: 0;
        border-radius: 12px;
        object-fit: cover;
        background: var(--fundo-2);
        box-shadow: 0 0 0 1px var(--anel);
    }

    .acoes-linha { display: flex; gap: 8px; flex-wrap: wrap; }

    .botao-pequena { min-height: 36px; padding: 4px 16px; font-size: .8125rem; }
    .botao-pequena .botao-icone { display: none; }

    tbody input[data-campo] {
        width: 100%;
        min-width: 90px;
        padding: 6px 10px;
        border: 0;
        border-radius: 10px;
        background: transparent;
        font: 500 .9375rem var(--texto);
        color: var(--tinta);
    }

    tbody input[data-campo]:not([disabled]) {
        background: var(--fundo);
        box-shadow: inset 0 0 0 1px var(--anel);
    }

    code {
        padding: 2px 6px;
        border-radius: 6px;
        background: var(--fundo-2);
        font-size: .85em;
    }

    @media (max-width: 900px) {
        .painel-grade { grid-template-columns: 1fr; }
        .bloco, .relatorio-cabeca { padding: 24px; }
        th, td { padding: 14px 24px; }
    }
</style>

<main>
    <div class="container">

        <section class="hero" data-revelar>
            <span class="selo">Área administrativa</span>
            <h1 class="titulo"><%= titulo %></h1>
            <p class="subtitulo">
                <% if (typeof usuario !== 'undefined' && usuario) { %>Olá, <%= usuario.login || usuario %>. <% } %>Cadastre candidatos e acompanhe o relatório da eleição.
            </p>
        </section>

        <div class="painel-grade" style="grid-template-columns: 1fr">

            <section class="casca" aria-labelledby="titulo-relatorio" data-revelar>
                <div class="nucleo">
                    <div class="relatorio-cabeca">
                        <h2 class="secao-titulo" id="titulo-relatorio">Relatório da eleição</h2>
                    </div>

                    <% if (relatorio && relatorio.length > 0) { %>
                        <table>
                            <thead>
                                <tr>
                                    <th scope="col">Candidato</th>
                                    <th scope="col">Número</th>
                                    <th scope="col" class="num">Votos</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% for (const linha of relatorio) { %>
                                    <tr>
                                        <td>
                                            <span class="relatorio-candidato">
                                                <% if (linha.foto) { %>
                                                    <img src="<%= linha.foto %>" alt="" width="44" height="44" loading="lazy">
                                                <% } %>
                                                <%= linha.nome %>
                                            </span>
                                        </td>
                                        <td><%- include('partials/numero.ejs', { numero: linha.numero ?? linha.numeroUrna }) %></td>
                                        <td class="num"><%= linha.votos %></td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    <% } else { %>
                        <div class="vazio">
                            <strong>Relatório vazio</strong>
                            Os candidatos cadastrados e seus votos aparecem aqui.
                        </div>
                    <% } %>
                </div>
            </section>

        </div>

        <div class="painel-grade" style="margin-top: 20px">

            <section class="casca" aria-labelledby="titulo-cadastro-api" data-revelar style="--atraso: .14s">
                <div class="nucleo bloco">
                    <h2 class="secao-titulo" id="titulo-cadastro-api">Novo candidato via API</h2>
                    <p class="bloco-descricao">Cadastra direto em <code>POST /api/candidatos</code>.</p>

                    <form id="form-novo-candidato-api">
                        <div class="campo">
                            <label for="api-nome">Nome</label>
                            <input type="text" id="api-nome" name="nome" minlength="3" autocomplete="off" required>
                        </div>

                        <div class="campo">
                            <label for="api-origem">Origem</label>
                            <input type="text" id="api-origem" name="origem" autocomplete="off">
                        </div>

                        <div class="campo">
                            <label for="api-numero">Número na urna</label>
                            <input type="number" id="api-numero" name="numeroUrna" min="1" max="99999" inputmode="numeric" required>
                        </div>

                        <div class="campo">
                            <label for="api-foto">URL da foto</label>
                            <input type="url" id="api-foto" name="foto" autocomplete="off">
                        </div>

                        <button type="submit" class="botao botao-confirma">
                            Cadastrar via API
                            <span class="botao-icone"><%- include('partials/seta.ejs') %></span>
                        </button>
                    </form>
                </div>
            </section>

            <section class="casca" aria-labelledby="titulo-lista-candidatos-api" data-revelar style="--atraso: .18s">
                <div class="nucleo">
                    <div class="relatorio-cabeca">
                        <h2 class="secao-titulo" id="titulo-lista-candidatos-api">Candidatos (API)</h2>
                    </div>

                    <% if (candidatosApi && candidatosApi.length > 0) { %>
                        <table>
                            <thead>
                                <tr>
                                    <th scope="col">Nome</th>
                                    <th scope="col">Origem</th>
                                    <th scope="col">Número</th>
                                    <th scope="col">Foto (URL)</th>
                                    <th scope="col">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% candidatosApi.forEach(c => { %>
                                    <tr data-linha-candidato data-numero="<%= c.numeroUrna %>">
                                        <td><input type="text" value="<%= c.nome %>" data-campo="nome" disabled></td>
                                        <td><input type="text" value="<%= c.origem || '' %>" data-campo="origem" disabled></td>
                                        <td><input type="number" value="<%= c.numeroUrna %>" data-campo="numeroUrna" disabled></td>
                                        <td><input type="url" value="<%= c.foto || '' %>" data-campo="foto" disabled></td>
                                        <td class="acoes-linha">
                                            <button type="button" class="botao botao-contorno botao-pequena" data-acao="editar">Editar</button>
                                            <button type="button" class="botao botao-contorno botao-pequena" data-acao="excluir">Excluir</button>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    <% } else { %>
                        <div class="vazio">
                            <strong>Nenhum candidato cadastrado via API</strong>
                        </div>
                    <% } %>
                </div>
            </section>

        </div>

        <div class="painel-grade" style="margin-top: 20px">

            <section class="casca" aria-labelledby="titulo-cadastro-voto-api" data-revelar style="--atraso: .22s">
                <div class="nucleo bloco">
                    <h2 class="secao-titulo" id="titulo-cadastro-voto-api">Novo registro de votos</h2>
                    <p class="bloco-descricao">Cria o registro em <code>POST /votos</code>, começando em zero.</p>

                    <form id="form-novo-voto-api">
                        <div class="campo">
                            <label for="api-voto-candidato">Número do candidato</label>
                            <input type="number" id="api-voto-candidato" name="candidatoId" min="1" max="99999" inputmode="numeric" required>
                            <small>Precisa ser o número de um candidato já cadastrado.</small>
                        </div>

                        <button type="submit" class="botao botao-confirma">
                            Criar registro de votos
                            <span class="botao-icone"><%- include('partials/seta.ejs') %></span>
                        </button>
                    </form>
                </div>
            </section>

            <section class="casca" aria-labelledby="titulo-lista-votos-api" data-revelar style="--atraso: .26s">
                <div class="nucleo">
                    <div class="relatorio-cabeca">
                        <h2 class="secao-titulo" id="titulo-lista-votos-api">Votos (API)</h2>
                    </div>

                    <% if (votosApi && votosApi.length > 0) { %>
                        <table>
                            <thead>
                                <tr>
                                    <th scope="col">Candidato</th>
                                    <th scope="col" class="num">Votos</th>
                                    <th scope="col">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% votosApi.forEach(v => { %>
                                    <tr data-linha-voto data-id="<%= v.candidatoId %>">
                                        <td><%- include('partials/numero.ejs', { numero: v.candidatoId }) %></td>
                                        <td class="num"><input type="number" value="<%= v.votos %>" data-campo="votos" disabled style="text-align: right; max-width: 100px"></td>
                                        <td class="acoes-linha">
                                            <button type="button" class="botao botao-contorno botao-pequena" data-acao="editar">Editar</button>
                                            <button type="button" class="botao botao-contorno botao-pequena" data-acao="excluir">Excluir</button>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    <% } else { %>
                        <div class="vazio">
                            <strong>Nenhum voto registrado via API</strong>
                        </div>
                    <% } %>
                </div>
            </section>

        </div>

    </div>
</main>

<script>
(function () {

    // ---------- Candidatos: editar / excluir linha ----------
    document.querySelectorAll('[data-linha-candidato]').forEach(function (tr) {
        var numero = tr.getAttribute('data-numero')
        var botaoEditar = tr.querySelector('[data-acao="editar"]')

        botaoEditar.addEventListener('click', function () {
            var editando = tr.getAttribute('data-editando') === '1'

            if (!editando) {
                tr.setAttribute('data-editando', '1')
                tr.querySelectorAll('input[data-campo]').forEach(function (input) { input.disabled = false })
                botaoEditar.textContent = 'Salvar'
                return
            }

            var corpo = {}
            tr.querySelectorAll('input[data-campo]').forEach(function (input) {
                corpo[input.dataset.campo] = input.value
            })

            fetch('/api/candidato/' + numero, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(corpo)
            })
                .then(function (resp) {
                    if (!resp.ok) throw new Error('Falha ao salvar candidato')
                    location.reload()
                })
                .catch(function (erro) { alert(erro.message) })
        })

        tr.querySelector('[data-acao="excluir"]').addEventListener('click', function () {
            if (!confirm('Remover este candidato?')) return

            fetch('/api/candidato/' + numero, { method: 'DELETE' })
                .then(function (resp) {
                    if (!resp.ok) throw new Error('Falha ao remover candidato')
                    location.reload()
                })
                .catch(function (erro) { alert(erro.message) })
        })
    })

    // ---------- Candidatos: cadastrar via API ----------
    var formNovoCandidato = document.getElementById('form-novo-candidato-api')
    if (formNovoCandidato) {
        formNovoCandidato.addEventListener('submit', function (e) {
            e.preventDefault()
            e.stopPropagation()

            var dados = Object.fromEntries(new FormData(formNovoCandidato))

            fetch('/api/candidatos', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(dados)
            })
                .then(function (resp) {
                    if (!resp.ok) return resp.json().then(function (corpo) { throw new Error(corpo.error || 'Falha ao cadastrar candidato') })
                    location.reload()
                })
                .catch(function (erro) { alert(erro.message) })
        })
    }

    // ---------- Votos: editar / excluir linha ----------
    document.querySelectorAll('[data-linha-voto]').forEach(function (tr) {
        var id = tr.getAttribute('data-id')
        var input = tr.querySelector('input[data-campo="votos"]')
        var botaoEditar = tr.querySelector('[data-acao="editar"]')

        botaoEditar.addEventListener('click', function () {
            var editando = tr.getAttribute('data-editando') === '1'

            if (!editando) {
                tr.setAttribute('data-editando', '1')
                input.disabled = false
                botaoEditar.textContent = 'Salvar'
                return
            }

            fetch('/votos/' + id, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ votos: input.value })
            })
                .then(function (resp) {
                    if (!resp.ok) throw new Error('Falha ao salvar votos')
                    location.reload()
                })
                .catch(function (erro) { alert(erro.message) })
        })

        tr.querySelector('[data-acao="excluir"]').addEventListener('click', function () {
            if (!confirm('Remover os votos deste candidato?')) return

            fetch('/votos/' + id, { method: 'DELETE' })
                .then(function (resp) {
                    if (!resp.ok) throw new Error('Falha ao remover votos')
                    location.reload()
                })
                .catch(function (erro) { alert(erro.message) })
        })
    })

    // ---------- Votos: criar registro via API ----------
    var formNovoVoto = document.getElementById('form-novo-voto-api')
    if (formNovoVoto) {
        formNovoVoto.addEventListener('submit', function (e) {
            e.preventDefault()
            e.stopPropagation()

            var dados = Object.fromEntries(new FormData(formNovoVoto))

            fetch('/votos', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(dados)
            })
                .then(function (resp) {
                    if (!resp.ok) return resp.json().then(function (corpo) { throw new Error(corpo.error || 'Falha ao criar registro de votos') })
                    location.reload()
                })
                .catch(function (erro) { alert(erro.message) })
        })
    }

})()
</script>

<%- include('partials/rodape.ejs') %>
