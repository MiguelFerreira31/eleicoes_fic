<%- include('partials/cabecalho.ejs') %>

    <main class="container mt-4">
        <h1>Bem-vindo ao Sistema de Eleições</h1>
        <p>Escolha uma das opções abaixo:</p>
        <form action="/painel/cad-candidato" method="post">
            <label for="nome">Nome:</label>
            <input type="text" id="nome" name="nome" required>

            <label for="numeroUrna">Número:</label>
            <input type="number" id="numeroUrna" name="numeroUrna" required>

            <button type="submit">Cadastrar Candidato</button>

        </form>


        <h2>Relatório de Eleições</h2>
        <table>
            <%for (const linha of relatorio) { %>
                <tr>
                    <td>
                        <%= linha.nome %>
                    </td>
                    <td>
                        <%= linha.numeroUrna %>
                    </td>
                    <td>
                        <%= linha.votos %>
                    </td>
                </tr>
                <% } %>
        </table>

        <a href="/painel/logout">Sair</a>
    </main>

    <%- include('partials/rodape.ejs') %>