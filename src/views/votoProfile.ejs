<%- include('partials/cabecalho.ejs') %>

<style>
    .apurado {
        display: grid;
        grid-template-columns: 7fr 5fr;
        gap: 20px;
    }

    .apurado .nucleo { padding: 36px; }

    .total { display: flex; flex-direction: column; justify-content: space-between; min-height: 340px; }

    .total-rotulo { color: var(--suave); font-size: .9375rem; }

    .total-votos {
        font: 900 clamp(6rem, 18vw, 11rem)/.8 var(--display);
        font-stretch: 125%;
        letter-spacing: -.06em;
        font-variant-numeric: tabular-nums;
    }

    .total-legenda { font: 700 1.5rem/1.2 var(--display); font-stretch: 115%; letter-spacing: -.02em; }

    .candidato-card { display: flex; flex-direction: column; justify-content: space-between; gap: 32px; height: 100%; }

    .candidato-card dt { color: var(--suave); font-size: .9375rem; margin-bottom: 14px; }
    .candidato-card dd { margin: 0; }

    .escuro .nucleo { background: var(--grafite); color: #fff; }
    .escuro .total-rotulo { color: rgba(255, 255, 255, .6); }

    @media (max-width: 900px) {
        .apurado { grid-template-columns: 1fr; }
        .total { min-height: 260px; }
        .apurado .nucleo { padding: 26px; }
    }
</style>

<main>
    <div class="container">

        <section class="hero" data-revelar>
            <a class="voltar" href="/candidato/<%= voto.candidatoId %>" style="margin-bottom: 28px">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M13 8H3M7 4L3 8l4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Perfil do candidato
            </a>
            <h1 class="titulo"><%= titulo %></h1>
        </section>

        <div class="apurado">
            <div class="casca escuro" data-revelar>
                <div class="nucleo total">
                    <span class="total-rotulo">Resultado apurado até agora</span>
                    <div>
                        <div class="total-votos" data-contar="<%= voto.votos %>"><%= voto.votos %></div>
                        <p class="total-legenda"><%= voto.votos === 1 ? 'voto recebido' : 'votos recebidos' %></p>
                    </div>
                </div>
            </div>

            <div class="casca" data-revelar style="--atraso: .1s">
                <dl class="nucleo candidato-card">
                    <div>
                        <dt>Candidato</dt>
                        <dd><%- include('partials/numero.ejs', { numero: voto.candidatoId, grande: true }) %></dd>
                    </div>
                    <div class="acoes">
                        <a href="/candidato/<%= voto.candidatoId %>" class="botao botao-confirma">
                            Ver perfil
                            <span class="botao-icone"><%- include('partials/seta.ejs') %></span>
                        </a>
                        <a href="/candidatos" class="botao botao-contorno" style="padding-right: 24px">Todos os candidatos</a>
                    </div>
                </dl>
            </div>
        </div>

    </div>
</main>

<%- include('partials/rodape.ejs') %>
